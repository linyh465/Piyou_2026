# 前端環境變數範例 / Frontend Environment Variables Example
# 複製此檔案為 .env.local 並填入真實值 / Copy to .env.local and fill real values
# 注意：VITE_ 前綴的變數會被打包進前端！勿放機密資訊
# Note: VITE_ prefixed vars are bundled into frontend! Do NOT put secrets here.

# ── 後端 API URL / Backend API URL ──────────────────
# 本機開發 / Local dev（留空，由 vite proxy 處理）/ Empty = handled by vite proxy
VITE_API_BASE_URL=

# Koyeb 正式後端 / Koyeb production backend:
# VITE_API_BASE_URL=https://<your-app>-<hash>.koyeb.app/api/v1

# ── GitHub Pages base path ──────────────────────────
# 有自訂網域 / Custom domain → 留空（預設 /）/ Leave empty (default /)
VITE_BASE_PATH=/

# 無自訂網域，部署到 username.github.io/Piyou_2026 時 / No custom domain:
# VITE_BASE_PATH=/Piyou_2026/
