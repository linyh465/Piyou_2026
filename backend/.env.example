# 環境變數範例 / Environment Variables Example
# 複製此檔案為 .env 並填入真實值 / Copy to .env and fill real values

# ── 核心設定 / Core ──────────────────────────────────

# JWT 密鑰 / JWT Secret Key
JWT_SECRET=your-super-secret-jwt-key-change-this

# 校務系統 URL / School Portal URL
SCHOOL_PORTAL_URL=https://alcat.pu.edu.tw

# TDX API 憑證 / TDX API Credentials
TDX_CLIENT_ID=your-tdx-client-id
TDX_CLIENT_SECRET=your-tdx-client-secret

# CORS 允許來源 / CORS Allowed Origins
# 本機開發 / Local dev:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Koyeb + GitHub Pages 正式 / Production:
# CORS_ORIGINS=https://<your-app>.github.io,https://<custom-domain>

# ── PostgreSQL（主要儲存後端）/ PostgreSQL (Primary Storage Backend) ─────
# Railway 自動注入 DATABASE_URL / Railway injects DATABASE_URL automatically
# 本機開發時填入你的連線字串 / For local dev, fill in your connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Google Sheets（歷史資料備份，移轉完成後可移除）───
# Service Account JSON 整串貼入 / Paste full service account JSON as one line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# 試算表 ID（URL 中的長字串）/ Spreadsheet ID from URL
GOOGLE_SHEETS_ID=your-spreadsheet-id

# ── Email 通知（Resend API）/ Email Notifications (Resend API) ──
# 收件人（你的信箱）/ Recipient (developer email)
NOTIFY_EMAIL=your-email@gmail.com
# Resend API Key（免費方案每月 3,000 封）/ Resend API Key (free: 3,000/month)
# 申請：https://resend.com → Settings → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Supabase（STORAGE_BACKEND=supabase 時填寫）──────
# Supabase 專案 URL / Project URL
SUPABASE_URL=https://xxxx.supabase.co
# Service Role Key（非 anon key！）/ Service Role Key (NOT anon key!)
SUPABASE_SERVICE_KEY=your-service-role-key
