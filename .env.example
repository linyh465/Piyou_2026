# ══════════════════════════════════════════
#  披呦環境變數範例 / Piyou Environment Variables Example
#  複製此檔案為 backend/.env 並填入真實值
#  Copy this file to backend/.env and fill in real values.
# ══════════════════════════════════════════

# ── JWT 密鑰 / JWT Secret Key ──
# 用於簽發與驗證 JWT Token（務必替換為隨機強密鑰）
# Used to sign/verify JWT tokens (MUST replace with a strong random key)
JWT_SECRET=your-super-secret-jwt-key-change-this

# ── 校務系統 URL / School Portal URL ──
SCHOOL_PORTAL_URL=https://alcat.pu.edu.tw

# ── TDX API 憑證 / TDX API Credentials ──
# 至 https://tdx.transportdata.tw/ 申請
# Apply at https://tdx.transportdata.tw/
TDX_CLIENT_ID=your-tdx-client-id
TDX_CLIENT_SECRET=your-tdx-client-secret

# ── CORS 允許來源 / CORS Allowed Origins ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
